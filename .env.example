# Supabase project URL and publishable (or legacy anon) key. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Exact origin for this deployment, without a trailing path. Use HTTPS outside localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
